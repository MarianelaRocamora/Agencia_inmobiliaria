@model Agencia_inmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Detalles del Pago";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: var(--color-primary);">
            <h4 class="mb-0">Detalles del Pago #@Model.IdPago</h4>
            <div>
                @if (Model.Estado)
                {
                    <span class="badge bg-success fs-6">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6">Anulado</span>
                }
            </div>
        </div>

        <div class="card-body">
            <h5 class="card-title text-primary border-bottom pb-2">Información del Pago</h5>
            
            <dl class="row mt-3">
                <dt class="col-sm-3">ID Pago</dt>
                <dd class="col-sm-9">@Model.IdPago</dd>

                <dt class="col-sm-3">ID Reserva</dt>
                <dd class="col-sm-9">@Model.IdReserva</dd>

                <dt class="col-sm-3">Concepto</dt>
                <dd class="col-sm-9">@Model.Concepto</dd>

                <dt class="col-sm-3">Fecha de Pago</dt>
                <dd class="col-sm-9">@Model.FechaPago.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">Importe</dt>
                <dd class="col-sm-9 fw-bold">
                    @Model.Importe.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @(Model.Estado ? "Activo" : "Anulado")
                </dd>
            </dl>

            @* Sección de Auditoría exclusivo Administrador *@
            @if (User.IsInRole("Administrador"))
            {
                <hr class="my-4" />
                <h5 class="card-title text-primary border-bottom pb-2">Auditoría de Registro</h5>

                <dl class="row">
                    <!-- Usuario Creador -->
                    <dt class="col-sm-3">Creado por</dt>
                    <dd class="col-sm-9">
                        @if (Model.UsuarioCreador != null)
                        {
                            <span>@Model.UsuarioCreador.Nombre @Model.UsuarioCreador.Apellido</span>
                            <span class="text-muted">(ID: @Model.UsuarioCreador.IdUsuario)</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>


                    <dt class="col-sm-3">Anulado por</dt>
                    <dd class="col-sm-9">
                        @if (!Model.Estado && Model.UsuarioAnulador != null)
                        {
                            <span class="text-danger">@Model.UsuarioAnulador.Nombre @Model.UsuarioAnulador.Apellido</span>
                            <span class="text-muted">(ID: @Model.UsuarioAnulador.IdUsuario)</span>
                        }
                        else if (!Model.Estado)
                        {
                            <span class="text-muted">Anulado (sin registro de usuario)</span>
                        }
                        else
                        {
                            <span class="text-muted">N/A (Pago Activo)</span>
                        }
                    </dd>
                </dl>
            }
        </div>

        <div class="card-footer bg-light text-end">
            <a asp-controller="Reserva" asp-action="Details" asp-route-id="@Model.IdReserva" class="btn btn-secondary">
                Volver a la Reserva
            </a>
        </div>
    </div>
</div>