@model Agencia_inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<h1>Editar Inmueble</h1>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdInmueble" />
    <input type="hidden" asp-for="Estado" />

    <div class="form-group mb-2">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Cupo" class="form-label"></label>
        <input asp-for="Cupo" class="form-control" />
        <span asp-validation-for="Cupo" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="PrecioDia" class="form-label"></label>
        <input asp-for="PrecioDia" class="form-control" />
        <span asp-validation-for="PrecioDia" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="PorcentajeReserva" class="form-label"></label>
        <input asp-for="PorcentajeReserva" class="form-control" />
        <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label class="form-label">Ubicación (hacé clic en el mapa para cambiar el punto)</label>
        <div id="mapa" style="height: 350px; width: 100%; border: 1px solid #ccc; border-radius: 4px;"></div>
    </div>
    <div class="row mb-2">
        <div class="col-md-6">
            <label asp-for="Latitud" class="form-label"></label>
            <input asp-for="Latitud" class="form-control" readonly />
            <span asp-validation-for="Latitud" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Longitud" class="form-label"></label>
            <input asp-for="Longitud" class="form-control" readonly />
            <span asp-validation-for="Longitud" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Portada" class="form-label"></label>
        <input asp-for="Portada" class="form-control" placeholder="URL o nombre de archivo de la imagen" />
        <span asp-validation-for="Portada" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="IdTipoInmueble" class="form-label"></label>
        <select asp-for="IdTipoInmueble" class="form-control" asp-items="ViewBag.TiposInmueble">
            <option value="">-- Seleccione un tipo --</option>
        </select>
        <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="IdPropietario" class="form-label"></label>
        <select asp-for="IdPropietario" class="form-control" asp-items="ViewBag.Propietarios">
            <option value="">-- Seleccione un propietario --</option>
        </select>
        <span asp-validation-for="IdPropietario" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Disponible" class="form-check-input" />
        <label asp-for="Disponible" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script>
        (function () {
            const inputLat = document.getElementById('Latitud');
            const inputLng = document.getElementById('Longitud');

            // Coordenadas iniciales .
            const latInicial = parseFloat(inputLat.value) || -33.295;
            const lngInicial = parseFloat(inputLng.value) || -66.335;

            const map = L.map('mapa').setView([latInicial, lngInicial], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = L.marker([latInicial, lngInicial]).addTo(map);

            function ubicarMarcador(lat, lng) {
                marker.setLatLng([lat, lng]);
                inputLat.value = lat.toFixed(6);
                inputLng.value = lng.toFixed(6);
            }

            map.on('click', function (e) {
                ubicarMarcador(e.latlng.lat, e.latlng.lng);
            });
        })();
    </script>
}
