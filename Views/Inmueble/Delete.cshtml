@model Agencia_inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Eliminar Inmueble";
}

<h1>Eliminar Inmueble</h1>

<div class="alert alert-warning">
    ¿Estás seguro de que querés eliminar este inmueble?
</div>

<dl class="row">
    <dt class="col-sm-2">Dirección</dt>
    <dd class="col-sm-10">@Model.Direccion</dd>

    <dt class="col-sm-2">Cupo</dt>
    <dd class="col-sm-10">@Model.Cupo</dd>

    <dt class="col-sm-2">Precio/día</dt>
    <dd class="col-sm-10">@Model.PrecioDia.ToString("C")</dd>

    <dt class="col-sm-2">% Reserva</dt>
    <dd class="col-sm-10">@Model.PorcentajeReserva %</dd>

    <dt class="col-sm-2">Disponible</dt>
    <dd class="col-sm-10">@(Model.Disponible ? "Sí" : "No")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdInmueble" />
    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
