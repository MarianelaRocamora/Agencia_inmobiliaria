@model IEnumerable<Agencia_inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
    int totalPaginas = Math.Max((int?)ViewBag.TotalPaginas ?? 1, 1);
    int paginaActual = Math.Clamp((int?)ViewBag.PaginaActual ?? 1, 1, totalPaginas);
    // Ventana de a lo sumo 5 números de página alrededor de la actual
    int desde = Math.Max(1, Math.Min(paginaActual - 2, totalPaginas - 4));
    int hasta = Math.Min(totalPaginas, desde + 4);
}

<h1>Inmuebles</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link active" id="tab-todos" data-bs-toggle="tab" data-bs-target="#panel-todos" type="button">Todos</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="tab-buscar" data-bs-toggle="tab" data-bs-target="#panel-buscar" type="button">Buscar por fechas</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="panel-todos">
        <p>
            <a asp-action="Create" class="btn btn-primary">Nuevo Inmueble</a>
        </p>
        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">@TempData["error"]</div>
        }
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success">@TempData["success"]</div>
        }
        <div class="d-flex align-items-center gap-2 mb-3">
            <label for="filtroDisponible" class="mb-0">Disponibilidad:</label>
            <select id="filtroDisponible" class="form-select" style="width: auto;">
                <option value="todos" selected>Todos</option>
                <option value="si">Disponibles</option>
                <option value="no">Suspendidos</option>
            </select>
        </div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Dirección</th>
                    <th>Propietario</th>
                    <th>Cupo</th>
                    <th>Precio/día</th>
                    <th>% Reserva</th>
                    <th>Disponible</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cuerpoTablaInmuebles">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Direccion</td>
                        <td>@item.Propietario?.Nombre @item.Propietario?.Apellido</td>
                        <td>@item.Cupo</td>
                        <td>@item.PrecioDia.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                        <td>@item.PorcentajeReserva %</td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-info">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-secondary">Editar</a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPaginas > 1)
        {
            <nav id="paginacionNormal" aria-label="Paginación de inmuebles">
                <ul class="pagination justify-content-center">
                    @if (paginaActual > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="1" title="Primera">&laquo;</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" title="Anterior">&lsaquo;</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                        <li class="page-item disabled"><span class="page-link">&lsaquo;</span></li>
                    }

                    @for (int p = desde; p <= hasta; p++)
                    {
                        if (p == paginaActual)
                        {
                            <li class="page-item active" aria-current="page"><span class="page-link">@p</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@p">@p</a></li>
                        }
                    }

                    @if (paginaActual < totalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" title="Siguiente">&rsaquo;</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas" title="Última">&raquo;</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">&rsaquo;</span></li>
                        <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
                    }
                </ul>
            </nav>
            <p class="text-center text-muted" id="textoPaginaNormal">Página @paginaActual de @totalPaginas</p>
        }
        <nav id="paginacionFiltro" aria-label="Paginación filtrada" style="display: none;">
            <ul class="pagination justify-content-center"></ul>
        </nav>
            <p class="text-center text-muted" id="textoPaginaFiltro" style="display: none;"></p>
    </div>

    <div class="tab-pane fade" id="panel-buscar">
        <p class="text-muted">
            Buscá inmuebles libres en un rango de fechas: se listan solo aquellos sin reservas 
            que se crucen con el período seleccionado.
        </p>
        <form id="formBuscarFechas" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Fecha de inicio</label>
                <input type="date" id="fechaInicioBusqueda" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha de fin</label>
                <input type="date" id="fechaFinBusqueda" class="form-control" required />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </form>

        <p id="mensajeBusqueda" class="text-muted"></p>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Dirección</th>
                    <th>Propietario</th>
                    <th>Cupo</th>
                    <th>Precio/día</th>
                    <th>% Reserva</th>
                    <th>Disponible</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cuerpoTablaBusqueda"></tbody>
        </table>

        <nav id="paginacionBusqueda" aria-label="Paginación de búsqueda">
            <ul class="pagination justify-content-center"></ul>
        </nav>
    </div>
</div>







@section Scripts {
    <script>
        const esAdministrador = @(User.IsInRole("Administrador") ? "true" : "false");
    </script>
    <script>
        const filtroDisponible = document.getElementById('filtroDisponible');
        const cuerpoTablaInmuebles = document.getElementById('cuerpoTablaInmuebles');
        const paginacionNormalInm = document.getElementById('paginacionNormal');
        const textoPaginaNormal = document.getElementById('textoPaginaNormal');
        const paginacionFiltroInm = document.getElementById('paginacionFiltro');
        const textoPaginaFiltro = document.getElementById('textoPaginaFiltro');
        const formatoMoneda = new Intl.NumberFormat(undefined, {
            style: 'currency',
            currency: 'ARS'
        });

        function cargarInmueblesFiltrados(disponible, pagina = 1) {
            fetch(`/Inmueble/FiltrarPorDisponibilidad?disponible=${disponible}&pagina=${pagina}`)
                .then(response => response.json())
                .then(data => {
                    cuerpoTablaInmuebles.innerHTML = '';

                    if (data.inmuebles.length === 0) {
                        cuerpoTablaInmuebles.innerHTML = '<tr><td colspan="7" class="text-muted text-center">No hay inmuebles para este filtro.</td></tr>';
                    } else {
                        const botonEliminar = esAdministrador
                                    ? `<a href="/Inmueble/Delete/${i.id}" class="btn btn-sm btn-danger">Eliminar</a>`
                                    : '';
                        data.inmuebles.forEach(i => {
                            const badge = i.disponible
                                ? '<span class="badge bg-success">Sí</span>'
                                : '<span class="badge bg-secondary">No</span>';

                            cuerpoTablaInmuebles.innerHTML += `
                                <tr>
                                    <td>${i.direccion}</td>
                                    <td>${i.propietario}</td>
                                    <td>${i.cupo}</td>
                                    <td>${formatoMoneda.format(i.precioDia)}</td>
                                    <td>${i.porcentajeReserva} %</td>
                                    <td>${badge}</td>
                                    <td>
                                        <a href="/Inmueble/Details/${i.id}" class="btn btn-sm btn-info">Detalles</a>
                                        <a href="/Inmueble/Edit/${i.id}" class="btn btn-sm btn-secondary">Editar</a>
                                        ${botonEliminar}
                                    </td>
                                </tr>`;
                        });
                    }

                    renderizarPaginacionFiltroInm(data.paginaActual, data.totalPaginas);
                })
                .catch(() => {
                    cuerpoTablaInmuebles.innerHTML = '<tr><td colspan="7" class="text-danger text-center">Error al cargar los inmuebles.</td></tr>';
                });
        }

        function renderizarPaginacionFiltroInm(paginaActual, totalPaginas) {
            const ul = paginacionFiltroInm.querySelector('ul');
            let html = '';

            if (totalPaginas > 1) {
                html += paginaActual > 1
                    ? `<li class="page-item"><a class="page-link" href="#" data-pagina="1">&laquo;</a></li>
                       <li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual - 1}">&lsaquo;</a></li>`
                    : `<li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                       <li class="page-item disabled"><span class="page-link">&lsaquo;</span></li>`;

                const desde = Math.max(1, Math.min(paginaActual - 2, totalPaginas - 4));
                const hasta = Math.min(totalPaginas, desde + 4);

                for (let p = desde; p <= hasta; p++) {
                    html += p === paginaActual
                        ? `<li class="page-item active"><span class="page-link">${p}</span></li>`
                        : `<li class="page-item"><a class="page-link" href="#" data-pagina="${p}">${p}</a></li>`;
                }

                html += paginaActual < totalPaginas
                    ? `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual + 1}">&rsaquo;</a></li>
                       <li class="page-item"><a class="page-link" href="#" data-pagina="${totalPaginas}">&raquo;</a></li>`
                    : `<li class="page-item disabled"><span class="page-link">&rsaquo;</span></li>
                       <li class="page-item disabled"><span class="page-link">&raquo;</span></li>`;
            }

            ul.innerHTML = html;
            textoPaginaFiltro.textContent = totalPaginas > 1 ? `Página ${paginaActual} de ${totalPaginas}` : '';

            ul.querySelectorAll('a[data-pagina]').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    cargarInmueblesFiltrados(filtroDisponible.value, parseInt(this.dataset.pagina));
                });
            });
        }

        filtroDisponible.addEventListener('change', function () {
            if (this.value === 'todos') {
                location.reload();
            } else {
                if (paginacionNormalInm) paginacionNormalInm.style.display = 'none';
                if (textoPaginaNormal) textoPaginaNormal.style.display = 'none';
                paginacionFiltroInm.style.display = 'block';
                textoPaginaFiltro.style.display = 'block';
                cargarInmueblesFiltrados(this.value, 1);
            }
        });

        const formBuscarFechas = document.getElementById('formBuscarFechas');
        const cuerpoTablaBusqueda = document.getElementById('cuerpoTablaBusqueda');
        const paginacionBusqueda = document.getElementById('paginacionBusqueda');
        const mensajeBusqueda = document.getElementById('mensajeBusqueda');
        let ultimaBusqueda = { inicio: null, fin: null };

        function buscarPorFechas(inicio, fin, pagina = 1) {
            mensajeBusqueda.textContent = 'Buscando...';

            fetch(`/Inmueble/BuscarPorFechasAjax?fechaInicio=${inicio}&fechaFin=${fin}&pagina=${pagina}`)
                .then(response => response.json())
                .then(data => {
                    cuerpoTablaBusqueda.innerHTML = '';

                    if (data.inmuebles.length === 0) {
                        mensajeBusqueda.textContent = 'No hay inmuebles disponibles para ese rango de fechas.';
                    } else {
                        mensajeBusqueda.textContent = '';
                        data.inmuebles.forEach(i => {
                            const badge = i.disponible
                                ? '<span class="badge bg-success">Sí</span>'
                                : '<span class="badge bg-secondary">No</span>';
                            cuerpoTablaBusqueda.innerHTML += `
                                <tr>
                                    <td>${i.direccion}</td>
                                    <td>${i.propietario}</td>
                                    <td>${i.cupo}</td>
                                    <td>${formatoMoneda.format(i.precioDia)}</td>
                                    <td>${i.porcentajeReserva}</td>
                                    <td>${badge}</td>
                                    <td><a href="/Inmueble/Details/${i.id}" class="btn btn-sm btn-info">Ver</a></td>
                                </tr>`;
                        });
                    }

                    renderizarPaginacionBusqueda(data.paginaActual, data.totalPaginas);
                })
                .catch(() => {
                    mensajeBusqueda.textContent = 'Error al buscar. Intente nuevamente.';
                });
        }

        function renderizarPaginacionBusqueda(paginaActual, totalPaginas) {
            const ul = paginacionBusqueda.querySelector('ul');
            let html = '';

            if (totalPaginas > 1) {
                if (paginaActual > 1) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual - 1}">&lsaquo;</a></li>`;
                }
                for (let p = 1; p <= totalPaginas; p++) {
                    html += p === paginaActual
                        ? `<li class="page-item active"><span class="page-link">${p}</span></li>`
                        : `<li class="page-item"><a class="page-link" href="#" data-pagina="${p}">${p}</a></li>`;
                }
                if (paginaActual < totalPaginas) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual + 1}">&rsaquo;</a></li>`;
                }
            }

            ul.innerHTML = html;
            ul.querySelectorAll('a[data-pagina]').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    buscarPorFechas(ultimaBusqueda.inicio, ultimaBusqueda.fin, parseInt(this.dataset.pagina));
                });
            });
        }

        formBuscarFechas.addEventListener('submit', function (e) {
            e.preventDefault();
            const inicio = document.getElementById('fechaInicioBusqueda').value;
            const fin = document.getElementById('fechaFinBusqueda').value;

            if (fin <= inicio) {
                mensajeBusqueda.textContent = 'La fecha de fin debe ser posterior a la de inicio.';
                return;
            }

            ultimaBusqueda = { inicio, fin };
            buscarPorFechas(inicio, fin, 1);
        });

        const cuerpoTablaMasReservados = document.getElementById('cuerpoTablaMasReservados');
        const paginacionMasReservados = document.getElementById('paginacionMasReservados');
        const tabMasReservados = document.getElementById('tab-mas-reservados');
        let masReservadosCargado = false;

        function cargarMasReservados(pagina = 1) {
            fetch(`/Inmueble/MasReservados?dias=365&pagina=${pagina}`)
                .then(response => response.json())
                .then(data => {
                    cuerpoTablaMasReservados.innerHTML = '';

                    if (data.inmuebles.length === 0) {
                        cuerpoTablaMasReservados.innerHTML = '<tr><td colspan="6" class="text-muted text-center">No hay inmuebles para mostrar.</td></tr>';
                    } else {
                        data.inmuebles.forEach(i => {
                            cuerpoTablaMasReservados.innerHTML += `
                                <tr>
                                    <td>${i.direccion}</td>
                                    <td>${i.propietario}</td>
                                    <td>${i.cupo}</td>
                                    <td>${formatoMoneda.format(i.precioDia)}</td>
                                    <td>${i.cantidadReservas}</td>
                                    <td><a href="/Inmueble/Details/${i.id}" class="btn btn-sm btn-info">Ver</a></td>
                                </tr>`;
                        });
                    }

                    renderizarPaginacionMasReservados(data.paginaActual, data.totalPaginas);
                })
                .catch(() => {
                    cuerpoTablaMasReservados.innerHTML = '<tr><td colspan="6" class="text-danger text-center">Error al cargar el informe.</td></tr>';
                });
        }

        function renderizarPaginacionMasReservados(paginaActual, totalPaginas) {
            const ul = paginacionMasReservados.querySelector('ul');
            let html = '';

            if (totalPaginas > 1) {
                if (paginaActual > 1) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual - 1}">&lsaquo;</a></li>`;
                }
                for (let p = 1; p <= totalPaginas; p++) {
                    html += p === paginaActual
                        ? `<li class="page-item active"><span class="page-link">${p}</span></li>`
                        : `<li class="page-item"><a class="page-link" href="#" data-pagina="${p}">${p}</a></li>`;
                }
                if (paginaActual < totalPaginas) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual + 1}">&rsaquo;</a></li>`;
                }
            }

            ul.innerHTML = html;
            ul.querySelectorAll('a[data-pagina]').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    cargarMasReservados(parseInt(this.dataset.pagina));
                });
            });
        }

        tabMasReservados.addEventListener('shown.bs.tab', function () {
            if (!masReservadosCargado) {
                masReservadosCargado = true;
                cargarMasReservados(1);
            }
        });
        
        const cuerpoTablaSinReservas = document.getElementById('cuerpoTablaSinReservas');
        const paginacionSinReservas = document.getElementById('paginacionSinReservas');
        const filtroDiasSinReservas = document.getElementById('filtroDiasSinReservas');
        const tabSinReservas = document.getElementById('tab-sin-reservas');
        let sinReservasCargado = false;

        function cargarSinReservas(dias, pagina = 1) {
            fetch(`/Inmueble/SinReservas?dias=${dias}&pagina=${pagina}`)
                .then(response => response.json())
                .then(data => {
                    cuerpoTablaSinReservas.innerHTML = '';

                    if (data.inmuebles.length === 0) {
                        cuerpoTablaSinReservas.innerHTML = '<tr><td colspan="6" class="text-muted text-center">No hay inmuebles sin reservas en ese período.</td></tr>';
                    } else {
                        data.inmuebles.forEach(i => {
                            const badge = i.disponible
                                ? '<span class="badge bg-success">Sí</span>'
                                : '<span class="badge bg-secondary">No</span>';
                            cuerpoTablaSinReservas.innerHTML += `
                                <tr>
                                    <td>${i.direccion}</td>
                                    <td>${i.propietario}</td>
                                    <td>${i.cupo}</td>
                                    <td>${formatoMoneda.format(i.precioDia)}</td>
                                    <td>${badge}</td>
                                    <td><a href="/Inmueble/Details/${i.id}" class="btn btn-sm btn-info">Ver</a></td>
                                </tr>`;
                        });
                    }

                    renderizarPaginacionSinReservas(data.paginaActual, data.totalPaginas);
                })
                .catch(() => {
                    cuerpoTablaSinReservas.innerHTML = '<tr><td colspan="6" class="text-danger text-center">Error al cargar el informe.</td></tr>';
                });
        }

        function renderizarPaginacionSinReservas(paginaActual, totalPaginas) {
            const ul = paginacionSinReservas.querySelector('ul');
            let html = '';

            if (totalPaginas > 1) {
                if (paginaActual > 1) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual - 1}">&lsaquo;</a></li>`;
                }
                for (let p = 1; p <= totalPaginas; p++) {
                    html += p === paginaActual
                        ? `<li class="page-item active"><span class="page-link">${p}</span></li>`
                        : `<li class="page-item"><a class="page-link" href="#" data-pagina="${p}">${p}</a></li>`;
                }
                if (paginaActual < totalPaginas) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual + 1}">&rsaquo;</a></li>`;
                }
            }

            ul.innerHTML = html;
            ul.querySelectorAll('a[data-pagina]').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    cargarSinReservas(filtroDiasSinReservas.value, parseInt(this.dataset.pagina));
                });
            });
        }

        tabSinReservas.addEventListener('shown.bs.tab', function () {
            if (!sinReservasCargado) {
                sinReservasCargado = true;
                cargarSinReservas(filtroDiasSinReservas.value, 1);
            }
        });

        filtroDiasSinReservas.addEventListener('change', function () {
            cargarSinReservas(this.value, 1);
        });

        const cuerpoTablaPorPropietario = document.getElementById('cuerpoTablaPorPropietario');
        const paginacionPorPropietario = document.getElementById('paginacionPorPropietario');
        const selectPropietarioInforme = document.getElementById('selectPropietarioInforme');

        function cargarPorPropietario(idPropietario, pagina = 1) {
            if (!idPropietario) {
                cuerpoTablaPorPropietario.innerHTML = '<tr><td colspan="6" class="text-muted text-center">Elegí un propietario para ver sus inmuebles.</td></tr>';
                paginacionPorPropietario.querySelector('ul').innerHTML = '';
                return;
            }

            fetch(`/Inmueble/PorPropietario?idPropietario=${idPropietario}&pagina=${pagina}`)
                .then(response => response.json())
                .then(data => {
                    cuerpoTablaPorPropietario.innerHTML = '';

                    if (data.inmuebles.length === 0) {
                        cuerpoTablaPorPropietario.innerHTML = '<tr><td colspan="6" class="text-muted text-center">Este propietario no tiene inmuebles.</td></tr>';
                    } else {
                        data.inmuebles.forEach(i => {
                            const badge = i.disponible
                                ? '<span class="badge bg-success">Sí</span>'
                                : '<span class="badge bg-secondary">No</span>';
                            cuerpoTablaPorPropietario.innerHTML += `
                                <tr>
                                    <td>${i.direccion}</td>
                                    <td>${i.cupo}</td>
                                    <td>${formatoMoneda.format(i.precioDia)}</td>
                                    <td>${i.porcentajeReserva} %</td>
                                    <td>${badge}</td>
                                    <td><a href="/Inmueble/Details/${i.id}" class="btn btn-sm btn-info">Ver</a></td>
                                </tr>`;
                        });
                    }

                    renderizarPaginacionPorPropietario(data.paginaActual, data.totalPaginas);
                })
                .catch(() => {
                    cuerpoTablaPorPropietario.innerHTML = '<tr><td colspan="6" class="text-danger text-center">Error al cargar el informe.</td></tr>';
                });
        }

        function renderizarPaginacionPorPropietario(paginaActual, totalPaginas) {
            const ul = paginacionPorPropietario.querySelector('ul');
            let html = '';

            if (totalPaginas > 1) {
                if (paginaActual > 1) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual - 1}">&lsaquo;</a></li>`;
                }
                for (let p = 1; p <= totalPaginas; p++) {
                    html += p === paginaActual
                        ? `<li class="page-item active"><span class="page-link">${p}</span></li>`
                        : `<li class="page-item"><a class="page-link" href="#" data-pagina="${p}">${p}</a></li>`;
                }
                if (paginaActual < totalPaginas) {
                    html += `<li class="page-item"><a class="page-link" href="#" data-pagina="${paginaActual + 1}">&rsaquo;</a></li>`;
                }
            }

            ul.innerHTML = html;
            ul.querySelectorAll('a[data-pagina]').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    cargarPorPropietario(selectPropietarioInforme.value, parseInt(this.dataset.pagina));
                });
            });
        }

        selectPropietarioInforme.addEventListener('change', function () {
            cargarPorPropietario(this.value, 1);
        });
     
    </script>
}