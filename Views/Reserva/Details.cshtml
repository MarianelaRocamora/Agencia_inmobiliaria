@model Agencia_inmobiliaria.Models.Reserva
@{
    ViewData["Title"] = "Detalle de la Reserva";
    var pagos = ViewBag.Pagos as IList<Agencia_inmobiliaria.Models.Pago> ?? new List<Agencia_inmobiliaria.Models.Pago>();
}

<h1>Detalle de la Reserva</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Datos del Inquilino</h4>
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Inquilino?.Nombre @Model.Inquilino?.Apellido</dd>

            <dt class="col-sm-4">DNI</dt>
            <dd class="col-sm-8">@Model.Inquilino?.Dni</dd>

            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@Model.Inquilino?.Telefono</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Inquilino?.Email</dd>
        </dl>
    </div>

    <div class="col-md-6">
        <h4>Datos del Inmueble</h4>
        <dl class="row">
            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@Model.Inmueble?.Direccion</dd>

            <dt class="col-sm-4">Tipo</dt>
            <dd class="col-sm-8">@Model.Inmueble?.TipoInmueble?.Nombre</dd>

            <dt class="col-sm-4">Cupo</dt>
            <dd class="col-sm-8">@Model.Inmueble?.Cupo personas</dd>

            <dt class="col-sm-4">Precio por día</dt>
            <dd class="col-sm-8">@Model.Inmueble?.PrecioDia.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</dd>
        </dl>
    </div>
</div>

<hr />

<h4>Datos de la Reserva</h4>
<dl class="row">
    <dt class="col-sm-3">Fecha Inicio</dt>
    <dd class="col-sm-9">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Fecha Fin</dt>
    <dd class="col-sm-9">@Model.FechaEgreso.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Monto Diario</dt>
    <dd class="col-sm-9">@Model.MontoDia.ToString("C")</dd>

    <dt class="col-sm-3">Fecha Cancelación</dt>
    <dd class="col-sm-9">
        @if (Model.FechaCancelacion is not null)
        {
            <span class="badge bg-danger">@Model.FechaCancelacion.Value.ToString("dd/MM/yyyy")</span>
        }
        else
        {
            <span class="text-muted">---</span>
        }
    </dd>

    @if (ViewBag.SenaSugerida is decimal senaSugerida)
    {
        <dt class="col-sm-3">Seña sugerida</dt>
        <dd class="col-sm-9">@senaSugerida.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</dd>
    }
</dl>

<div class="mt-4 mb-4">
    <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-warning">Editar</a>

    @if (Model.FechaCancelacion is null)
    {
        <a asp-action="Extender" asp-route-id="@Model.IdReserva" class="btn btn-primary">Extender Reserva</a>
        <a asp-action="Cancelar" asp-route-id="@Model.IdReserva" class="btn btn-danger">Cancelar Reserva</a>
    }

    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>

<hr />

<h4>Pagos</h4>

@if (!pagos.Any())
{
    <p class="text-muted">Todavía no hay pagos registrados para esta reserva.</p>
}
else
{
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Concepto</th>
                <th>Fecha de pago</th>
                <th>Importe</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pago in pagos)
            {
                <tr>
                    <td>@pago.Concepto</td>
                    <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                    <td>@pago.Importe.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                    <td>
                        @if (pago.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Anulado</span>
                        }
                    </td>
                    <td>
                        @if (pago.Estado)
                        {
                            <a asp-controller="Pago" asp-action="Edit" asp-route-id="@pago.IdPago" class="btn btn-sm btn-warning">Editar concepto</a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-controller="Pago" asp-action="Details" asp-route-id="@pago.IdPago" class="btn btn-sm btn-info">Ver</a>
                            }
                            <form asp-controller="Pago" asp-action="Anular" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@pago.IdPago" />
                                <input type="hidden" name="idReserva" value="@Model.IdReserva" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('¿Anular este pago?');">Anular</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h5>Registrar nuevo pago</h5>
<form asp-controller="Pago" asp-action="Create" method="post" class="row g-2 align-items-end mb-4">
    <input type="hidden" name="IdReserva" value="@Model.IdReserva" />
    <input type="hidden" name="Estado" value="true" />

    <div class="col-md-4">
        <label class="form-label">Concepto</label>
        <input type="text" name="Concepto" class="form-control" maxlength="100" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Fecha de pago</label>
        <input type="date" name="FechaPago" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Importe</label>
        <input type="number" step="0.01" min="0.01" name="Importe" class="form-control" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Registrar</button>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <hr />
        <h5>Auditoría</h5>
        <dl class="row">
            <dt class="col-sm-3">Creada por</dt>
            <dd class="col-sm-9">
                @Model.UsuarioCreador?.Nombre @Model.UsuarioCreador?.Apellido
                <span class="text-muted">(ID: @Model.UsuarioCreador?.IdUsuario)</span>
            </dd>
            

            <dt class="col-sm-3">Finalizada por</dt>
            <dd class="col-sm-9">
                @(Model.UsuarioFinalizador != null 
                ? $"{Model.UsuarioFinalizador.Nombre} {Model.UsuarioFinalizador.Apellido} (ID: {Model.UsuarioFinalizador.IdUsuario})" 
                : "-")
            </dd>
        </dl>
    }
</form>